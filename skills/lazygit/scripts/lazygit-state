#!/usr/bin/env python3
"""lazygit-state [-L SOCK] PANE - which panel is focused and which row is
selected, without reading the whole screen back to the model.

Measured with lazygit 0.4x, default theme: the FOCUSED
panel's border is bold green (ESC[1mESC[32m before the box characters and
its "[N]─Title"); the SELECTED row carries a blue background (ESC[44m).
Prints two lines:  panel: N Title   /   row: <text of the selected row>
Exit 2 when no lazygit paint is found (the pane is not running lazygit).
"""
import re, subprocess, sys

args = sys.argv[1:]
L = []
if args[:1] == ["-L"]:
    L = ["-L", args[1]]; args = args[2:]
if not args:
    sys.exit(__doc__.strip())
pane = args[0]
raw = subprocess.run(["tmux", *L, "capture-pane", "-e", "-p", "-t", pane],
                     capture_output=True, text=True).stdout
SGR = re.compile(r"\x1b\[[0-9;]*m")
panel = row = None
BOLD = re.compile(r"\x1b\[1m\x1b\[3([26])m[^\x1b\[]*\[(\d)\][─-]+(?:\x1b\[32m)?([A-Za-z][^─\x1b]*?)(?:\x1b|─)")
TYPING = re.compile(r"\[(\d)\][─-]+\x1b\[32m([A-Za-z][^─\x1b]*?)(?:\x1b|─)")
lines = raw.splitlines()
# pass 1: the focused frame is bold green (normal) or bold cyan (a filter/search confirmed)
for line in lines:
    m = BOLD.search(line)
    if m:
        panel = f"{m.group(2)} {m.group(3).strip()}" + (" (searching)" if m.group(1) == "6" else "")
        break
# pass 2: while the prompt is open the frame is plain and only the title is green
if panel is None:
    for line in lines:
        m = TYPING.search(line)
        if m:
            panel = f"{m.group(1)} {m.group(2).strip()} (typing)"
            break
for line in lines:
    if "\x1b[44m" in line:
        seg = line.split("\x1b[44m", 1)[1]
        seg = seg.split("\x1b[49m", 1)[0]
        seg = SGR.sub("", seg).strip()
        # the left panel's text ends at the panel border
        seg = re.split(r"[│▐▌]", seg)[0].strip()
        row = seg
        break
if panel is None and row is None:
    print("lazygit-state: no lazygit paint in that pane", file=sys.stderr); sys.exit(2)
print(f"panel: {panel or '?'}")
print(f"row: {row or '?'}")
