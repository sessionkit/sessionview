#!/bin/sh
# nvim-read SOCK FILE - FILE as the user has it now in nvim, unsaved changes
# included, on stdout (one newline after each line). No keys are sent.
# Exit 3: FILE is not open in nvim, with one line (read it from disk
# instead). Exit 2: usage, or no nvim on SOCK.
set -eu
S="${1:-}"; F="${2:-}"
if [ -z "$S" ] || [ -z "$F" ]; then echo "usage: nvim-read SOCK FILE" >&2; exit 2; fi
case "$F" in /*) ;; *) F="$(pwd)/$F";; esac
FV="$(printf %s "$F" | sed "s/'/''/g")"
BUF="get(filter(getbufinfo(), {_, b -> resolve(b.name) ==# resolve('$FV')}), 0, {})"
N="$(nvim --server "$S" --remote-expr "get($BUF, 'bufnr', -1)")"
if [ "$N" = -1 ]; then echo "nvim-read: $F is not open in nvim; read it from disk" >&2; exit 3; fi
nvim --server "$S" --remote-expr "join(map(getbufline($N, 1, '\$'), {_, l -> l . \"\\n\"}), '')"
